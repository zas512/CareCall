# CareCall — Real service integrations (fill with your own keys)
# Database
DATABASE_URL=postgresql://user:pass@host:5432/carecall

# Queue / Scheduling
REDIS_URL=redis://localhost:6379

# Vapi (telephony AI agent)
VAPI_API_KEY=<your-vapi-api-key>
VAPI_PHONE_NUMBER_ID=<your-vapi-phone-id>
VAPI_WEBHOOK_SECRET=<your-vapi-webhook-secret>

# Twilio (SMS escalations)
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_PHONE_NUMBER=<your-twilio-phone-number>

# OpenAI (structured summarization — GPT-4o-mini)
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_SUMMARY_MODEL=gpt-4o-mini

# App / Call constraints
NODE_ENV=development
LOG_LEVEL=info
CALL_HARD_CAP_SECONDS=300
VAD_SILENCE_TIMEOUT_MS=5000
